# Canonical redirects apply only to the production domains, allowing local previews.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^(www\.)?filiposcar\.co\.uk$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^filiposcar\.com$ [NC]
    RewriteRule ^ https://www.filiposcar.com%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^www\.filiposcar\.com$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://www.filiposcar.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# Retain existing album shortcuts.
Redirect 301 /raven-white https://filiposcar.bandcamp.com/album/raven-white
Redirect 301 /brokenness-trio https://filiposcar.bandcamp.com/album/brokenness-trio
Redirect 301 /twig https://filiposcar.bandcamp.com/album/the-way-is-golden

<IfModule mod_mime.c>
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType image/avif .avif
    AddType application/javascript .js
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Replace both Apache header tables to avoid duplicate cache policies with PHP/FastCGI.
    <FilesMatch "\.php$">
        Header unset Cache-Control
        Header always set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Do not serve PHP configuration or credentials as downloadable static files.
<IfModule mod_authz_core.c>
    <FilesMatch "(?i)^(?:php\.ini|\.user\.ini|\.htaccess|\.htpasswd|\.env(?:\..*)?)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Do not inherit a host-wide expiry policy for the changing homepage.
<IfModule mod_expires.c>
    <FilesMatch "\.php$">
        ExpiresActive Off
    </FilesMatch>
</IfModule>
