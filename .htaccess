<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect non-www to www
  RewriteCond %{HTTP_HOST} ^filiposcar\.com$ [NC]
  RewriteRule ^(.*)$ https://www.filiposcar.com/$1 [L,R=301]

  # Redirect .co.uk to .com
  RewriteCond %{HTTP_HOST} ^(www\.)?filiposcar\.co\.uk$ [NC]
  RewriteRule ^(.*)$ https://www.filiposcar.com/$1 [L,R=301]
</IfModule>

##<IfModule mod_rewrite.c>
